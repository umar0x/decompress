{
  "name": "@umar0x/decompress-cli",
  "version": "1.0.0",
  "description": "CLI for secure archive extraction with extract, list, and audit commands",
  "license": "MIT",
  "author": "umar0x <hello@umar.ac>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umar0x/decompress.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/umar0x/decompress#readme",
  "bugs": "https://github.com/umar0x/decompress/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "decompress": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@umar0x/decompress": "^1.0.0"
  }
}
