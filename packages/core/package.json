{
  "name": "@umar0x/decompress",
  "version": "1.0.6",
  "description": "Secure, fast archive extraction for Node.js. ZIP, TAR, TAR.GZ, TAR.BZ2, and TAR.ZST with parallel bzip2, atomic commits, and hardening against Zip Slip, symlink escapes, hardlink escapes, zip bombs, and Windows path tricks.",
  "license": "MIT",
  "author": "umar0x <hello@umar.ac>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umar0x/decompress.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/umar0x/decompress#readme",
  "bugs": "https://github.com/umar0x/decompress/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "extract",
    "archive",
    "unzip",
    "untar",
    "zip",
    "tar",
    "gzip",
    "bzip2",
    "zstd",
    "tar.gz",
    "tar.bz2",
    "tar.zst",
    "decompress",
    "uncompress",
    "secure",
    "zip-slip",
    "path-traversal",
    "symlink",
    "zip-bomb",
    "nodejs",
    "file-compression"
  ],
  "devDependencies": {
    "tar-stream": "^3.2.1",
    "yauzl": "^3.4.0",
    "unbzip2-stream": "^1.4.3",
    "seek-bzip": "^2.0.0"
  }
}
